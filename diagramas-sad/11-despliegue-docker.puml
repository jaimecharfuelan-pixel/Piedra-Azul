@startuml 11-despliegue-docker
title Piedra Azul — Figura 11 — Vista de despliegue (Docker Compose)
skinparam backgroundColor white
skinparam shadowing false

node "Host Docker" {
  node "piedraazul-frontend" as FE {
    artifact "nginx\nSPA Angular :4200→80" as NGX
  }
  node "piedraazul-backend" as BE {
    artifact "Spring Boot\nJRE 17 :8080" as APP
  }
  node "piedraazul-keycloak" as KC {
    artifact "Keycloak 26\nrealm piedraazul :8180" as KEY
  }
  node "piedraazul-db" as DBN {
    database "PostgreSQL 16\n:5432" as DB
  }
  node "piedraazul-docs\n(opcional)" as DOC {
    artifact "MkDocs :8000" as MK
  }
}

actor "Navegador / Postman" as U
U --> FE : :4200
U --> KC : Admin / token :8180
FE --> BE : /api proxy
BE --> DB : JDBC
BE --> KC : password grant + JWKS
note right of APP
  APP_SEED_ENABLED=true
  SeedDatosDemo (usuarios locales)
  Roles/credenciales en Keycloak
end note
note right of KEY
  Realm import:
  keycloak/realm-piedraazul.json
  Roles: ADMINISTRADOR, AGENDADOR,
  MEDICO, PACIENTE
end note

@enduml
