%% --------------------- RELACIONES ---------------------
    TimeRange ..> DiaSemana : coopera
    RangoFechas ..> DiaSemana : coopera
    MedicoReadModel ..> EspecialidadMedica : referencia
    AgendaMedico "1" --> "1" MedicoId : pertenece a
    ConfiguracionSistema ..> RangoFechas : produce
    Cita ..|> EstadoCitaContext
    Cita "1" --> "1" EstadoCita : tiene
    Cita "1" o-- "1" EstadoCitaState : delega comportamiento
    Cita "1" *-- "1" AuditMetadata : compone
    Cita "1" --> "1" CitaId : identificada por
    Cita "1" --> "1" PacienteId : referencia
    Cita "1" --> "1" MedicoId : referencia
    Cita "1" --> "1" UsuarioId : creada por
    Cita "1" --> "1" EspecialidadMedica : de especialidad
    Cita "1" --> "1" TipoAgendamiento : clasificada como
    Cita ..> AgendaMedico : valida contra
    EstadoCitaState <|.. AbstractEstadoCitaState
    AbstractEstadoCitaState <|-- ProgramadaState
    AbstractEstadoCitaState <|-- ReagendadaState
    AbstractEstadoCitaState <|-- AtendidaState
    AbstractEstadoCitaState <|-- CanceladaState
    AbstractEstadoCitaState <|-- NoAsistidaState
    EstadoCitaStateFactory ..> EstadoCitaState : crea
    EstadoCitaStateFactory ..> EstadoCita : resuelve desde
    EstadoCita ..> EstadoCitaStateFactory : consulta
    AbstractEstadoCitaState ..> EstadoCitaContext : muta
    ProgramadaState ..> CitaNoCancelableException : lanza
    AbstractEstadoCitaState ..> CitaNoReagendableException : lanza
    AbstractEstadoCitaState ..> CitaNoMarcableException : lanza
    CitaBuilder <|-- CitaManualBuilder
    CitaBuilder <|-- CitaAutonomaBuilder
    CitaBuilder <|-- CitaReagendadaBuilder
    CitaBuilder ..> Cita : construye
    CitaBuilder ..> MedicoReadModel : valida
    CitaBuilder ..> PacienteReadModel : valida
    CitaBuilder ..> AgendaMedico : valida
    CitaBuilder ..> MedicoNoDisponibleException : lanza
    CitaBuilder ..> PacienteNoDisponibleException : lanza
    CitaBuilder ..> SlotNoDisponibleException : lanza
    CitaManualFactory ..|> CitaBuilderFactory
    CitaAutonomaFactory ..|> CitaBuilderFactory
    CitaManualFactory ..> CitaManualBuilder : crea
    CitaAutonomaFactory ..> CitaAutonomaBuilder : crea
    DatosCreacionCita o-- MedicoReadModel
    DatosCreacionCita o-- PacienteReadModel
    DatosCreacionCita o-- AgendaMedico
    DatosCreacionCita o-- ConfiguracionSistema
    FiltroBusquedaCitas *-- RangoFechas
    FiltroBusquedaCitas ..> EstadoCita : filtra por
    FiltroBusquedaCitas ..> EspecialidadMedica : filtra por
    ConsultaGeneralPolicy ..> ConsultaGeneralRequeridaException : lanza
    CitaProgramadaUnicaPolicy ..> RestriccionAutoservicioException : lanza
    VentanaAgendamientoPolicy ..> ConfiguracionSistema : consulta
    VentanaAgendamientoPolicy ..> SlotNoDisponibleException : lanza
    CitaNoEncontradaException --|> RecursoNoEncontradoException
    CitaNoCancelableException --|> ReglaDeNegocioException
    CitaNoReagendableException --|> ReglaDeNegocioException
    CitaNoMarcableException --|> ReglaDeNegocioException
    MedicoNoDisponibleException --|> ReglaDeNegocioException
    PacienteNoDisponibleException --|> ReglaDeNegocioException
    SlotNoDisponibleException --|> ReglaDeNegocioException
    ConsultaGeneralRequeridaException --|> ReglaDeNegocioException
    RestriccionAutoservicioException --|> ReglaDeNegocioException
