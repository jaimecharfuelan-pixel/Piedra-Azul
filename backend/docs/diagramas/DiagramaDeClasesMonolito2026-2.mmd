        }

        %% unifica String diaSemana (personas-service) con DayOfWeek (citas-service)
        %% y reemplaza el enum vacio DiaSemanaLaboral y la clase DiaSemanaMapper
        class DiaSemana {
            <<enumeration>>
            LUNES
            MARTES
            MIERCOLES
            JUEVES
            VIERNES
            SABADO
            DOMINGO
            +desdeDayOfWeek(dia: DayOfWeek) DiaSemana
            +aDayOfWeek() DayOfWeek
            +desdeTexto(valor: String) DiaSemana
            +getEtiqueta() String
        }

        %% adaptado de EspecialidadMedica (existia duplicado en citas y personas)
        class EspecialidadMedica {
            <<enumeration>>
            GENERAL
            TERAPEUTA_NEURAL
            QUIROPRACTICO
            FISIOTERAPEUTA
            +getEtiqueta() String
