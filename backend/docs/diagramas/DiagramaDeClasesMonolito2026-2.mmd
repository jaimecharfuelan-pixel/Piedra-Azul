        }

        %% adaptado de UsuarioId en citas-service
        class UsuarioId {
            <<ValueObject adaptado de UsuarioId>>
            -value: UUID
            +of(value: UUID) UsuarioId
            +getValue() UUID
        }

        class PersonaId {
            <<ValueObject>>
            -value: Long
            +of(value: Long) PersonaId
            +getValue() Long
        }

        class DisponibilidadId {
            <<ValueObject>>
            -value: Long
            +of(value: Long) DisponibilidadId
