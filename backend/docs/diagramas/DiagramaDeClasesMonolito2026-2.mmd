            +inicioDelRango() LocalDateTime
            +finDelRango() LocalDateTime
            +contiene(fecha: LocalDate) boolean
            +getFechaInicio() LocalDate
            +getFechaFin() LocalDate
        }

        %% adaptado de CitaId en citas-service (domain.valueobjects)
        class CitaId {
            <<ValueObject adaptado de CitaId>>
            -value: UUID
            +generate() CitaId
            +fromString(value: String) CitaId
            +of(value: UUID) CitaId
            +getValue() UUID
            +toString() String
        }

        %% adaptado de PacienteId en citas-service
        class PacienteId {
            <<ValueObject adaptado de PacienteId>>
            -value: Long
            +of(value: Long) PacienteId
            +getValue() Long
        }

        %% adaptado de MedicoId en citas-service
        class MedicoId {
