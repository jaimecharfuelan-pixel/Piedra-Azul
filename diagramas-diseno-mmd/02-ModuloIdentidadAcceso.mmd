%% --------------------- RELACIONES ---------------------
    UsuarioController ..> RegistrarUsuarioUseCase : invoca
    UsuarioController ..> ConsultarUsuarioUseCase : invoca
    AutenticacionController ..> AutenticarUsuarioUseCase : invoca
    RegistrarUsuarioService ..|> RegistrarUsuarioUseCase
    AutenticarUsuarioService ..|> AutenticarUsuarioUseCase
    ConsultarUsuarioService ..|> ConsultarUsuarioUseCase
    RegistrarUsuarioService --> UsuarioRepository : depende
    RegistrarUsuarioService --> ProveedorIdentidadPort : depende
    RegistrarUsuarioService --> RegistroPacientePort : depende
    RegistrarUsuarioService ..> UsuarioApplicationMapper : usa
    AutenticarUsuarioService --> UsuarioRepository : depende
    AutenticarUsuarioService --> ProveedorIdentidadPort : depende
    ConsultarUsuarioService --> UsuarioRepository : depende
    RegistrarUsuarioService ..> RegistrarUsuarioCommand : recibe
    RegistrarUsuarioService ..> Usuario : crea
    RegistrarUsuarioService ..> UsuarioResponseDTO : retorna
    Usuario "1" o-- "1..*" RolUsuario : posee
    Usuario "1" --> "1" UsuarioId : identificado por
    Usuario "1" --> "1" PersonaId : referencia
    KeycloakIdentidadAdapter ..|> ProveedorIdentidadPort
    IdentidadLocalAdapter ..|> ProveedorIdentidadPort
    KeycloakIdentidadAdapter *-- KeycloakAdminProperties
    IdentidadLocalAdapter --> PasswordHasherPort : depende
    IdentidadLocalAdapter --> TokenProviderPort : depende
    IdentidadLocalAdapter --> CredencialRepository : depende
    BCryptPasswordHasherAdapter ..|> PasswordHasherPort
    JwtTokenProviderAdapter ..|> TokenProviderPort
    JwtTokenProviderAdapter ..> TokenResponseDTO : produce
    UsuarioRepositoryAdapter ..|> UsuarioRepository
    UsuarioRepositoryAdapter --> SpringDataUsuarioRepository : delega
    UsuarioRepositoryAdapter *-- UsuarioPersistenceMapper
    UsuarioPersistenceMapper ..> UsuarioJpaEntity : mapea
    UsuarioPersistenceMapper ..> Usuario : mapea
    SpringDataUsuarioRepository ..> UsuarioJpaEntity : gestiona
    UsuarioApplicationMapper ..> UsuarioResponseDTO : produce
    RegistrarUsuarioRequestDTO ..> RegistrarUsuarioCommand : se transforma en
    RegistrarUsuarioCommand *-- DatosPacienteAutoRegistroDTO
    RegistrarUsuarioCommand ..> RolUsuario : referencia
    UsuarioResponseDTO ..> RolUsuario : referencia
    TokenResponseDTO ..> RolUsuario : referencia
    AutenticacionController ..> LoginRequestDTO : recibe
