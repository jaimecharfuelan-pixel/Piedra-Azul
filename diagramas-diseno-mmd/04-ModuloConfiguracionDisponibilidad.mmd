%% --------------------- RELACIONES ---------------------
    TimeRange ..> DiaSemana : coopera
    RangoFechas ..> DiaSemana : coopera
    ConfiguracionController ..> ConsultarConfiguracionUseCase : invoca
    ConfiguracionController ..> ActualizarConfiguracionUseCase : invoca
    ConfiguracionController ..> GestionarFestivosUseCase : invoca
    DisponibilidadController ..> CrearDisponibilidadUseCase : invoca
    DisponibilidadController ..> ActualizarDisponibilidadUseCase : invoca
    DisponibilidadController ..> EliminarDisponibilidadUseCase : invoca
    DisponibilidadController ..> ConsultarDisponibilidadUseCase : invoca
    ConfiguracionService ..|> ConsultarConfiguracionUseCase
    ConfiguracionService ..|> ActualizarConfiguracionUseCase
    ConfiguracionService ..|> GestionarFestivosUseCase
    CrearDisponibilidadService ..|> CrearDisponibilidadUseCase
    ActualizarDisponibilidadService ..|> ActualizarDisponibilidadUseCase
    EliminarDisponibilidadService ..|> EliminarDisponibilidadUseCase
    ConsultarDisponibilidadService ..|> ConsultarDisponibilidadUseCase
    ConfiguracionService *-- ConfiguracionManager
    ConfiguracionService ..> ConfiguracionApplicationMapper : usa
    ConfiguracionManager --> ConfiguracionRepository : depende
    ConfiguracionManager "1" o-- "1" ConfiguracionSistema : cachea
    CrearDisponibilidadService --> DisponibilidadRepository : depende
    CrearDisponibilidadService --> CatalogoMedicosPort : depende
    CrearDisponibilidadService --> ValidadorSolapamientoDisponibilidad : usa
