    Notificacion "1" --> "1" TipoNotificacion : es de tipo
    Notificacion "1" --> "1" CanalNotificacion : se envia por
    Notificacion "1" --> "1" NotificacionId : identificada por
    Notificacion "1" --> "1" PersonaId : dirigida a
    InAppCanalAdapter ..|> CanalNotificacionPort
    EmailCanalAdapter ..|> CanalNotificacionPort
    NotificacionRepositoryAdapter ..|> NotificacionRepository
    NotificacionRepositoryAdapter --> SpringDataNotificacionRepository : delega
    NotificacionRepositoryAdapter *-- NotificacionPersistenceMapper
    SpringDataNotificacionRepository ..> NotificacionJpaEntity : gestiona
    NotificacionPersistenceMapper ..> NotificacionJpaEntity : mapea
    NotificacionPersistenceMapper ..> Notificacion : mapea
    NotificacionesModuleFacade ..|> NotificadorCitasPort
    NotificacionesModuleFacade --> EnviarNotificacionUseCase : depende
    NotificacionesModuleFacade *-- ConstructorMensajeCita
    NotificacionesModuleFacade ..> Cita : lee
    NotificacionesModuleFacade ..> MedicoReadModel : lee
    NotificacionesModuleFacade ..> PacienteReadModel : lee
    CitaEventListener --> EnviarNotificacionUseCase : depende
    CitaEventListener *-- ConstructorMensajeCita
    CitaEventListener ..> CitaAgendadaEvent : escucha
    CitaEventListener ..> CitaCanceladaEvent : escucha
    CitaEventListener ..> CitaReagendadaEvent : escucha
    ConstructorMensajeCita ..> EnviarNotificacionCommand : produce
    NotificacionApplicationMapper ..> NotificacionResponseDTO : produce
    NotificacionController ..> ConteoNotificacionesDTO : retorna
    UsuarioAutenticadoResolver ..> PersonaId : resuelve
    NotificacionController ..> UsuarioAutenticadoResolver : usa
